{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "umeng-dau-client",
  "version": "0.1.0",
  "identifier": "com.umeng.dauclient",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "友盟 DAU 批量执行客户端",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["sdk-bundle/**/*"],
    "windows": {
      "nsis": {
        "compression": "zlib"
      }
    }
  }
}
